---
import { settings } from '../lib/site';
interface Props { topic?: string; item?: string; submitLabel?: string; compact?: boolean }
const { topic = 'Something else', item = '', submitLabel = 'Send message', compact = false } = Astro.props;
const topics = ['Artwork enquiry', 'Gallery shop', 'Workshop booking', 'Event RSVP', "I'm an artist", 'Something else'];
const key = settings.web3formsKey;
const thanks = new URL('/thanks/', Astro.site ?? Astro.url).href;
---
{key ? (
  <form class={`form ${compact ? 'form--compact' : ''}`} action="https://api.web3forms.com/submit" method="POST">
    <input type="hidden" name="access_key" value={key} />
    <input type="hidden" name="subject" value={`New enquiry from the ${settings.siteName} website`} />
    <input type="hidden" name="from_name" value={settings.siteName} />
    <input type="hidden" name="redirect" value={thanks} />
    <input type="checkbox" name="botcheck" class="visually-hidden" tabindex="-1" autocomplete="off" />
    <div class="form__row">
      <label>Name<input type="text" name="name" required autocomplete="name" /></label>
      <label>Email<input type="email" name="email" required autocomplete="email" /></label>
    </div>
    <label>Phone (optional)<input type="tel" name="phone" autocomplete="tel" /></label>
    <label>What's it about?
      <select name="topic">
        {topics.map((t) => <option selected={t === topic}>{t}</option>)}
      </select>
    </label>
    {item !== '' && <label>Which work or item?<input type="text" name="item" value={item} /></label>}
    <label>Message<textarea name="message" rows="5" required></textarea></label>
    <button type="submit" class="btn btn--solid">{submitLabel}</button>
  </form>
) : (
  <div class="notice">
    <p>Our online form is coming soon. In the meantime, email <a href={`mailto:${settings.email}`}>{settings.email}</a> or call <a href={`tel:${settings.phone.replace(/\s/g, '')}`}>{settings.phone}</a>.</p>
  </div>
)}
