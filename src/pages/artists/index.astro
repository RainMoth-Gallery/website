---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Photo from '../../components/Photo.astro';
import { visible, tone } from '../../lib/site';
const artists = (await getCollection('artists')).filter(visible).sort((a, b) => a.data.order - b.data.order || a.data.name.localeCompare(b.data.name));
---
<Layout title="Artists" description="Local and Riverland artists and makers shown at Rain Moth Gallery, Waikerie.">
  <section class="page-intro">
    <h1>Artists</h1>
    <p class="lead">Meet the local and Riverland artists and makers whose work you'll find in our exhibitions and gallery shop.</p>
  </section>

  <section class="section" style="border-top: 1px solid var(--line)" aria-label="Artist list">
    {artists.length === 0 && <p class="empty">Artist profiles are coming soon.</p>}
    <div class="grid" style="grid-template-columns: repeat(auto-fill, minmax(min(100%, 250px), 1fr))">
      {artists.map((a, i) => (
        <a class="card" href={`/artists/${a.id}/`}>
          <div class="card__media card__media--tall"><Photo src={a.data.portrait || a.data.works[0]?.image} alt="" label="Artwork or portrait" colour={tone(i)} /></div>
          <p class="card__title" style="margin-top: 6px">{a.data.name}</p>
          <p class="muted" style="font-size: 14px">{[a.data.medium, a.data.town].filter(Boolean).join(' · ')}</p>
          <span class="text-link" style="min-height: 0">View artist →</span>
        </a>
      ))}
    </div>
  </section>

  <section class="section" style="text-align:center">
    <h2 style="font-size: 24px">Are you an artist?</h2>
    <p class="lead" style="margin-inline:auto">We welcome local artists who'd like to exhibit, or sell work in our gallery shop.</p>
    <p style="margin-top: 18px"><a class="btn" href="/contact-visit/#enquire">Get in touch</a></p>
  </section>
</Layout>
